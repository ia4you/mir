DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

NEXTAUTH_SECRET=genera_uno_con_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

ANTHROPIC_API_KEY=

# STRIPE_SECRET_KEY debería ser sk_test_... en cualquier entorno que no sea
# el despliegue real de Dokploy (mir.turel.es). Una clave sk_live_ en local
# o en un script manual apunta a la cuenta real de Stripe: los scripts en
# scripts/stripe_setup_*.mjs piden confirmación explícita si detectan una
# clave live, pero evita tenerla en tu .env.local salvo que sepas lo que
# haces.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

GROQ_API_KEY=

# Web Push (VAPID) — generadas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com
# el cliente (banner en /inicio) necesita la clave pública para pushManager.subscribe();
# solo las variables NEXT_PUBLIC_ llegan al bundle del navegador en Next.js
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# protege /api/push/send (endpoint interno, llamado solo por el cron de recordatorios)
CRON_SECRET=
# protege /api/track-visit (endpoint interno, llamado solo por middleware.js)
TRACK_SECRET=

# Google Analytics 4 (propiedad "MIR Turel"). Solo se inicializa cuando
# NODE_ENV === "production" (ver app/layout.js), pero rellénala igualmente
# para probar el build de producción en local.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
